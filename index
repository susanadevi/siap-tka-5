    <!-- JAVASCRIPT UTAMA -->
    <script>
        const appRoot = document.getElementById('cbt-app-root');
        if (appRoot && appRoot.parentNode !== document.body) {
            document.body.appendChild(appRoot);
        }

        const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbycv0Lst9M6SEH9X6gtpWSak7a1C3LLR6Kaa_0_v5lxlv4Z-mwC8HlJhR_Sanv5FpU-/exec"; 

        let users_db = [];
        try { users_db = JSON.parse(localStorage.getItem('cbt_users')) || []; } catch(e) { users_db = []; }
        
        let results_db = [];
        try { results_db = JSON.parse(localStorage.getItem('cbt_results')) || []; } catch(e) { results_db = []; }

        let currentUser = null; 
        let currentStudent = null; 
        let currentSoalIndex = 0;
        let studentAnswers = {}; 
        let doubtAnswers = {}; 

        let cheatCount = 0;
        let isExamActive = false;
        let lastCheatTime = 0;
        let isAlerting = false;
        let isSubmitting = false; 

        let examTimerInterval = null;
        let freezeInterval = null;
        let devClickTimer = null;
        let examTimeLeft = 40 * 60; 

        function escapeHTML(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        async function postToCloud(payload) {
            isSubmitting = true;
            try {
                const response = await fetch(SCRIPT_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });
                if (!response.ok) throw new Error("HTTP Status " + response.status);
                const result = await response.json();
                if (result.status !== "success") {
                    throw new Error(result.message || "Server menolak permintaan.");
                }
                return result;
            } finally {
                isSubmitting = false;
            }
        }

        let questions = [];

        // Cache request yang sedang berjalan supaya beberapa pemanggil (init, guru, siswa)
        // yang butuh data cloud di waktu bersamaan cukup memakai SATU koneksi ke server,
        // bukan request terpisah-pisah yang saling menunggu (ini sumber utama loading lama).
        let cloudFetchPromise = null;

        async function fetchCloudSnapshot(showAlert = false) {
            if (SCRIPT_URL.includes("ISI_DENGAN_URL")) {
                if (showAlert) alert("PERHATIAN: SCRIPT_URL belum disetting. Silakan ganti dengan URL Web App Anda.");
                return null;
            }
            if (!cloudFetchPromise) {
                cloudFetchPromise = (async () => {
                    try {
                        const response = await fetch(SCRIPT_URL);
                        if (!response.ok) throw new Error("HTTP Status " + response.status);
                        const result = await response.json();
                        if (result.status !== "success") {
                            throw new Error(result.message || "Server tidak mengembalikan status sukses.");
                        }

                        if (result.guru && Array.isArray(result.guru)) {
                            users_db = result.guru;
                            localStorage.setItem('cbt_users', JSON.stringify(users_db));
                        }
                        if (result.nilai && Array.isArray(result.nilai)) {
                            results_db = result.nilai;
                            localStorage.setItem('cbt_results', JSON.stringify(results_db));
                        }
                        if (result.soal && Array.isArray(result.soal) && result.soal.length > 0) {
                            questions = result.soal;
                        }
                        return result;
                    } catch (error) {
                        console.warn("Gagal menyinkronkan data dengan Cloud. Memakai cache lokal.", error);
                        return null;
                    } finally {
                        cloudFetchPromise = null;
                    }
                })();
            }
            const result = await cloudFetchPromise;
            if (!result && showAlert) alert("Gagal terhubung ke Cloud server. Memakai data lokal.");
            return result;
        }

        async function sinkronDataDariCloud(showAlert = false) {
            const result = await fetchCloudSnapshot(showAlert);
            if (result) {
                if (showAlert) alert("Sinkronisasi data Cloud berhasil!");
                if (currentUser && currentUser.role === 'guru') {
                    loadGuruDashboard();
                }
                return true;
            }
            return false;
        }

        async function loadSoalDariCloud() {
            if (questions && questions.length > 0) return true;
            await fetchCloudSnapshot();
            return !!(questions && questions.length > 0);
        }

        function navigate(pageId) {
            document.querySelectorAll('.page').forEach(el => el.classList.remove('active'));
            const target = document.getElementById(pageId);
            if (target) target.classList.add('active');
        }

        function toggleSekolahManual() {
            const pilihan = document.getElementById('siswa-asal-sekolah-pilihan').value;
            const manualInput = document.getElementById('siswa-asal-sekolah-manual');
            if (pilihan === '__LAINNYA__') {
                manualInput.classList.remove('hidden');
                manualInput.required = true;
                manualInput.value = '';
                manualInput.focus();
            } else {
                manualInput.classList.add('hidden');
                manualInput.required = false;
                manualInput.value = '';
            }
        }

        window.addEventListener('load', async () => {
            const result = await fetchCloudSnapshot();
            if (currentUser && currentUser.role === 'guru') {
                loadGuruDashboard();
            }
            if (!result || !questions || questions.length === 0) {
                console.warn("Soal belum berhasil dimuat saat load awal. Akan dicoba lagi saat siswa login.");
            }

            const freezeUntil = localStorage.getItem('cheat_freeze_until');
            if (freezeUntil) {
                const now = Date.now();
                const timeRemaining = parseInt(freezeUntil) - now;
                if (timeRemaining > 0) {
                    enforceFreezePenalty(timeRemaining);
                    return; 
                } else {
                    localStorage.removeItem('cheat_freeze_until');
                }
            }

            const savedGuru = localStorage.getItem('active_guru');
            if(savedGuru) {
                try {
                    currentUser = JSON.parse(savedGuru);
                    if (currentUser && currentUser.token) {
                        document.getElementById('dash-guru-info').innerText = `${currentUser.nama} | Token Siswa: ${currentUser.token}`;
                        loadGuruDashboard();
                        navigate('page-guru-dash');
                    }
                } catch(e) {
                    localStorage.removeItem('active_guru');
                }
            }
        });

        window.addEventListener('keydown', function(e) {
            if (!isExamActive) return;
            if (e.key === 'ArrowLeft') { e.preventDefault(); prevSoal(); }
            if (e.key === 'ArrowRight') { e.preventDefault(); nextSoal(); }
            if (e.key === 'F12' || 
               (e.ctrlKey && ['c', 'v', 'u', 'i', 'j'].includes(e.key.toLowerCase())) || 
               (e.ctrlKey && e.shiftKey && ['i', 'j', 'c'].includes(e.key.toLowerCase()))) {
                e.preventDefault();
                alert("Aksi tombol ini diblokir selama ujian berlangsung!");
            }
        });

        window.addEventListener('beforeunload', function (e) {
            if (isExamActive) { e.preventDefault(); e.returnValue = ''; }
        });

        function resetGuruAuth() {
            document.getElementById('guru-master-token').value = '';
            document.getElementById('guru-auth-step1').classList.remove('hidden');
            document.getElementById('guru-auth-step2').classList.add('hidden');
            navigate('page-landing');
        }

        /* VERIFIKASI VIA BACKEND / GOOGLE APPS SCRIPT */
        async function verifyMasterToken() {
            const tokenInput = document.getElementById('guru-master-token');
            const token = tokenInput.value.toUpperCase().trim();
            
            if (!token) {
                alert("Silakan masukkan Token Akses!");
                return;
            }

            const btn = document.getElementById('btn-verify-master');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Memeriksa ke Server...';
            btn.disabled = true;

            try {
                const res = await postToCloud({ action: "verify_master_token", token: token });
                
                if (res.status === "success") {
                    if (res.role === "admin") {
                        navigate('page-admin-dash');
                        loadAdminDashboard();
                    } else if (res.role === "guru_master") {
                        document.getElementById('guru-auth-step1').classList.add('hidden');
                        document.getElementById('guru-auth-step2').classList.remove('hidden');
                        switchGuruTab('login');
                    }
                } else {
                    alert(res.message || 'Token Akses tidak valid!');
                }
            } catch (err) {
                alert('Gagal memverifikasi token ke server: ' + err.message);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        function switchGuruTab(tab) {
            document.getElementById('form-guru-login').classList.toggle('hidden', tab !== 'login');
            document.getElementById('form-guru-daftar').classList.toggle('hidden', tab !== 'daftar');
            document.getElementById('tab-login-guru').className = tab === 'login' ? 'flex-1 py-2 font-semibold text-primary border-b-2 border-primary' : 'flex-1 py-2 font-semibold text-gray-400 border-b border-transparent';
            document.getElementById('tab-daftar-guru').className = tab === 'daftar' ? 'flex-1 py-2 font-semibold text-primary border-b-2 border-primary' : 'flex-1 py-2 font-semibold text-gray-400 border-b border-transparent';
        }

        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        async function handleGuruDaftar(e) {
            e.preventDefault();
            
            const nama = document.getElementById('guru-daftar-nama').value;
            const token = document.getElementById('guru-daftar-token').value.toUpperCase();
            const pin = document.getElementById('guru-daftar-pin').value;

            if (users_db.some(u => u.token === token)) {
                alert('Token ini sudah digunakan. Buat token yang berbeda.');
                return;
            }

            const btn = document.getElementById('btn-daftar-guru');
            btn.innerHTML = 'Mendaftarkan ke Cloud...';
            btn.disabled = true;

            let newGuru = { role: 'guru', nama, token, pin, waktu_daftar: new Date().toISOString() };

            try {
                await sinkronDataDariCloud();
                if (users_db.some(u => u.token === token)) {
                    alert('Token ini sudah digunakan (setelah sinkron terbaru). Buat token yang berbeda.');
                    return;
                }

                await postToCloud({ action: "register_guru", data: newGuru });

                users_db.push(newGuru);
                localStorage.setItem('cbt_users', JSON.stringify(users_db));

                alert('Ruang ujian berhasil dibuat di Cloud! Silakan masuk dengan PIN Anda.');
                switchGuruTab('login');
                document.getElementById('guru-login-nama').value = nama;
            } catch (err) {
                alert('Gagal mendaftar ke Cloud: ' + err.message + '\n\nRuang ujian TIDAK dibuat. Periksa koneksi internet dan coba lagi.');
            } finally {
                btn.innerHTML = 'Buat Ruang Ujian Cloud';
                btn.disabled = false;
            }
        }

        function handleGuruLogin(e) {
            e.preventDefault();
            const nama = document.getElementById('guru-login-nama').value;
            const pin = document.getElementById('guru-login-pin').value;
            
            const guru = users_db.find(u => u.nama.toLowerCase() === nama.toLowerCase() && u.pin === pin);
            
            if (guru) {
                currentUser = guru;
                localStorage.setItem('active_guru', JSON.stringify(guru));
                document.getElementById('dash-guru-info').innerText = `${guru.nama} | Token Siswa: ${guru.token}`;
                navigate('page-guru-dash');
                loadGuruDashboard();
            } else {
                alert('Nama Guru atau PIN salah!');
            }
        }

        function loadGuruDashboard() {
            const tbody = document.getElementById('tbody-guru-dash');
            tbody.innerHTML = '';
            
            let siswaTerkait = results_db.filter(r => r.token_guru === currentUser.token);
            
            if (siswaTerkait.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-4 text-center text-gray-500">Belum ada siswa yang menyelesaikan ujian di ruang ini.</td></tr>`;
                return;
            }
            
            siswaTerkait.forEach((r, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${idx + 1}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${escapeHTML(r.nama)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${escapeHTML(r.kelas)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${escapeHTML(r.sekolah)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold ${r.nilai >= 70 ? 'text-green-600' : 'text-red-600'}">${r.nilai}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${new Date(r.waktu).toLocaleTimeString('id-ID')}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-red-500">${r.cheat_count || 0} kali</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function loadAdminDashboard() {
            const tNilai = document.getElementById('tbody-admin-dash');
            tNilai.innerHTML = '';
            results_db.forEach((r, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">${new Date(r.waktu).toLocaleString('id-ID')}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-700">${escapeHTML(r.token_guru)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${escapeHTML(r.nama)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${escapeHTML(r.kelas)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${escapeHTML(r.sekolah)}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold">${r.nilai}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-blue-600 cursor-pointer hover:underline" onclick="hapusNilai('${r.waktu}')">Hapus</td>
                `;
                tNilai.appendChild(tr);
            });

            const tGuru = document.getElementById('tbody-admin-guru');
            tGuru.innerHTML = '';
