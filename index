        function setupAntiCheat() {
            document.addEventListener('contextmenu', e => {
                if (isExamActive) e.preventDefault();
            });
            
            document.addEventListener('visibilitychange', () => {
                if (!isExamActive || isSubmitting) return; 
                if (document.hidden) handleCheat();
            });
            
            window.addEventListener('blur', () => {
                if (!isExamActive || isSubmitting) return;
                const now = Date.now();
                if (now - lastCheatTime > 2000) { 
                    handleCheat();
                    lastCheatTime = now;
                }
            });
        }

        function handleCheat() {
            if (isAlerting) return;
            cheatCount++;
            isAlerting = true;
            
            if (cheatCount >= 3) {
                alert("PELANGGARAN BERAT! Anda telah 3 kali berpindah aplikasi/layar. Ujian dibekukan selama 5 Menit!");
                const unfreezeTime = Date.now() + (300 * 1000); 
                localStorage.setItem('cheat_freeze_until', unfreezeTime.toString());
                enforceFreezePenalty(300 * 1000);
            } else {
                alert(`PERINGATAN KECURANGAN! (${cheatCount}/3)\n\nSistem mendeteksi Anda berpindah layar atau minimize browser.\nJika mencapai 3 kali, ujian akan dibekukan!`);
            }
            saveSession();
            setTimeout(() => { isAlerting = false; }, 1000);
        }

        function enforceFreezePenalty(durationMs) {
            isExamActive = false;
            clearInterval(examTimerInterval);
            
            const overlay = document.getElementById('freeze-overlay');
            const timerEl = document.getElementById('freeze-timer');
            overlay.classList.remove('hidden');
            
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(e => console.log(e));
            }
            
            let secondsLeft = Math.ceil(durationMs / 1000);
            timerEl.innerText = secondsLeft;
            
            if (freezeInterval) clearInterval(freezeInterval);
            freezeInterval = setInterval(() => {
                secondsLeft--;
                timerEl.innerText = secondsLeft;
                
                if (secondsLeft <= 0) {
                    clearInterval(freezeInterval);
                    overlay.classList.add('hidden');
                    localStorage.removeItem('cheat_freeze_until');
                    cheatCount = 0; 
                    alert("Waktu pembekuan selesai. Silakan lanjutkan ujian dengan jujur.");
                    
                    if (currentStudent && currentStudent.nama) {
                        isExamActive = true;
                        startExamTimer();
                    } else {
                        navigate('page-landing'); 
                    }
                }
            }, 1000);
        }

        async function finishExam(force = false) {
            if (!force) {
                const isUnanswered = (q) => {
                    if (q.type === 'PG') return !studentAnswers[q.id];
                    if (q.type === 'MCMA') return !studentAnswers[q.id] || studentAnswers[q.id].length === 0;
                    if (q.type === 'KISI') return !studentAnswers[q.id] || Object.keys(studentAnswers[q.id]).length < q.options.length;
                    return true;
                };

                const unansIndex = questions.findIndex(isUnanswered);
                const unans = questions.filter(isUnanswered).length;

                const ragu = Object.values(doubtAnswers).filter(v => v).length;

                if (unans > 0) {
                    alert(`Ujian belum bisa dikirim!\n\nMasih ada ${unans} soal yang BELUM DIJAWAB. Silakan lengkapi semua jawaban terlebih dahulu sebelum mengirim ujian.`);
                    if (unansIndex !== -1) {
                        currentSoalIndex = unansIndex;
                        loadSoal(unansIndex);
                    }
                    return;
                }

                let msg = "Apakah Anda yakin ingin menyelesaikan ujian ini?";
                if (ragu > 0) msg += `\nMasih ada ${ragu} soal yang RAGU-RAGU.`;
                
                if (!confirm(msg)) return;
            }

            isExamActive = false;
            clearInterval(examTimerInterval);
            document.getElementById('btn-finish').innerHTML = "Menyimpan...";
            document.getElementById('btn-finish').disabled = true;

            let score = 0;
            const maxScorePerSoal = 100 / questions.length; 

            questions.forEach(q => {
                if (q.type === 'PG') {
                    if (studentAnswers[q.id] === q.answer) score += maxScorePerSoal;
                } 
                else if (q.type === 'MCMA') {
                    let ans = studentAnswers[q.id] || [];
                    let wrongCount = 0;
                    ans.forEach(a => { if (!q.answer.includes(a)) wrongCount++; });
                    const allCorrectSelected = q.answer.every(a => ans.includes(a));
                    if (wrongCount === 0 && allCorrectSelected) {
                        score += maxScorePerSoal;
                    }
                }
                else if (q.type === 'KISI') {
                    let ansObj = studentAnswers[q.id] || {};
                    const allCorrect = q.options.every((stmt, i) => ansObj[i] === q.answer[i]);
                    if (allCorrect) score += maxScorePerSoal;
                }
            });

            score = Math.round(score);

            const resultData = {
                waktu: new Date().toISOString(),
                nama: currentStudent.nama,
                kelas: currentStudent.kelas,
                sekolah: currentStudent.sekolah,
                token_guru: currentStudent.token_guru,
                nilai: score,
                cheat_count: cheatCount
            };

            results_db.push(resultData);
            localStorage.setItem('cbt_results', JSON.stringify(results_db));
            
            try {
                await postToCloud({ action: "submit_nilai", data: resultData });
                console.log("Nilai terkirim ke Cloud");
            } catch (err) {
                console.warn("Gagal mengirim nilai ke Cloud, tersimpan lokal. Sebab:", err.message);
            }

            localStorage.removeItem('cbt_ongoing_session');
            
            if (document.exitFullscreen && document.fullscreenElement) {
                document.exitFullscreen().catch(()=>{});
            }

            document.getElementById('result-student-info').innerText = `${currentStudent.nama} - ${currentStudent.kelas}`;
            
            let displayScore = 0;
            const scoreEl = document.getElementById('result-score');
            const scoreInterval = setInterval(() => {
                displayScore += 2;
                if (displayScore >= score) {
                    displayScore = score;
                    clearInterval(scoreInterval);
                    setTimeout(() => {
                        document.getElementById('btn-pembahasan').classList.remove('hidden');
                    }, 500);
                }
                scoreEl.innerText = displayScore;
            }, 20);

            generatePembahasan();
            navigate('page-result');
            
            document.getElementById('btn-finish').innerHTML = "Selesai";
            document.getElementById('btn-finish').disabled = false;
        }

        function generatePembahasan() {
