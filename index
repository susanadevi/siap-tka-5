        function saveAnswerMCMA(qId, value, isChecked) {
            if (!studentAnswers[qId]) studentAnswers[qId] = [];
            if (isChecked) {
                studentAnswers[qId].push(value);
            } else {
                studentAnswers[qId] = studentAnswers[qId].filter(v => v !== value);
            }
            if (studentAnswers[qId].length === 0) delete studentAnswers[qId];
            saveSession();
            updateNavStyling();
        }

        function saveAnswerKISI(qId, stmtIndex, label) {
            if (!studentAnswers[qId]) studentAnswers[qId] = {};
