                    html += `<div class="mb-2 text-sm"><span class="font-semibold">Jawaban Anda:</span> <span class="${ans === q.answer ? 'text-green-600' : 'text-red-600'}">${ans || '(Kosong)'}</span></div>`;
                    html += `<div class="mb-4 text-sm"><span class="font-semibold text-green-700">Kunci Jawaban:</span> ${q.answer}</div>`;
                } else if (q.type === 'MCMA') {
                    const ans = studentAnswers[q.id] || [];
                    html += `<div class="mb-2 text-sm"><span class="font-semibold">Jawaban Anda:</span> <span class="text-blue-600">${ans.length > 0 ? ans.join(', ') : '(Kosong)'}</span></div>`;
                    html += `<div class="mb-4 text-sm"><span class="font-semibold text-green-700">Kunci Jawaban:</span> ${q.answer.join(', ')}</div>`;
                } else if (q.type === 'KISI') {
                    const ans = studentAnswers[q.id] || {};
                    html += `<div class="text-sm bg-gray-50 p-2 rounded mb-4"><table class="w-full text-xs">`;
                    q.options.forEach((opt, i) => {
                        const sAns = ans[i] || '-';
                        const isC = sAns === q.answer[i];
                        html += `<tr class="border-b"><td class="py-1 pr-2">${opt}</td>
                            <td class="py-1 font-semibold ${isC ? 'text-green-600' : 'text-red-600'}">Jawab: ${sAns}</td>
                            <td class="py-1 font-semibold text-green-700 text-right">Kunci: ${q.answer[i]}</td></tr>`;
                    });
                    html += `</table></div>`;
                }

                html += `<div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-900">
                    <strong class="block mb-1 text-blue-700">Pembahasan:</strong>
                    ${q.pembahasan}
                </div>`;

                card.innerHTML = html;
                container.appendChild(card);
            });
        }

        function isAnswerCorrect(q) {
            if (q.type === 'PG') return studentAnswers[q.id] === q.answer;
            if (q.type === 'MCMA') {
                let ans = studentAnswers[q.id] || [];
                if(ans.length === 0) return false;
                let wrong = false;
                ans.forEach(a => { if(!q.answer.includes(a)) wrong = true; });
                const allCorrectSelected = q.answer.every(a => ans.includes(a));
                return !wrong && allCorrectSelected;
            }
            if (q.type === 'KISI') {
                let ans = studentAnswers[q.id] || {};
                let correctCount = 0;
                q.options.forEach((stmt, i) => {
                    if (ans[i] === q.answer[i]) correctCount++;
                });
                return correctCount === q.options.length; 
            }
            return false;
        }

        async function triggerEasterEgg() {
            if (!devClickTimer) {
                devClickTimer = 1;
                setTimeout(() => { devClickTimer = null; }, 2000);
            } else {
                devClickTimer++;
                if (devClickTimer >= 5) {
                    devClickTimer = null; 
                    const adminCode = prompt("Masukkan Kode Rahasia Super Admin:");
                    
                    if (adminCode) {
                        try {
                            const res = await postToCloud({ action: "verify_master_token", token: adminCode.trim().toUpperCase() });
                            if (res.status === "success" && res.role === "admin") {
                                navigate('page-admin-dash');
                                loadAdminDashboard();
                            } else {
                                alert("Kode rahasia salah.");
                            }
                        } catch (e) {
                            alert("Gagal memverifikasi kode rahasia.");
                        }
                    }
                }
            }
        }
    </script>
