                            ${isAnswerCorrect(q) ? 'Benar' : 'Salah'}
                        </span>
                    </div>
                `;

                if (q.wacana) {
                    html += `<div class="mb-4 text-sm text-gray-500 bg-gray-50 p-3 rounded overflow-hidden max-h-32 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-12 after:bg-gradient-to-t after:from-gray-50 after:to-transparent">[Kutipan Wacana ${q.wacana.match(/<h3>(.*?)<\/h3>/)?.[1] || ''}]</div>`;
                }

