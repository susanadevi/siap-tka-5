        async function handleSiswaLogin(e) {
            e.preventDefault();
            const nama = document.getElementById('siswa-nama').value;
            const kelas = document.getElementById('siswa-kelas').value;
            const sekolahPilihan = document.getElementById('siswa-asal-sekolah-pilihan').value;
            const sekolah = sekolahPilihan === '__LAINNYA__'
                ? document.getElementById('siswa-asal-sekolah-manual').value.trim()
                : sekolahPilihan;
            const token = document.getElementById('siswa-token').value.toUpperCase();

            if (!sekolah) {
                alert('Silakan pilih atau ketik nama sekolah!');
                return;
            }

            if (!questions || questions.length === 0) {
                const btn = e.target.querySelector('button[type="submit"]');
                const originalLabel = btn ? btn.innerHTML : null;
                if (btn) { btn.innerHTML = 'Memuat soal...'; btn.disabled = true; }
                const soalOk = await loadSoalDariCloud();
                if (btn) { btn.innerHTML = originalLabel; btn.disabled = false; }
                if (!soalOk || questions.length === 0) {
                    alert('Gagal memuat soal dari server. Periksa koneksi internet Anda, lalu coba lagi.');
                    return;
                }
            }

            let validGuru = users_db.find(u => u.token === token);
            if (!validGuru) {
                const btn = e.target.querySelector('button[type="submit"]');
                const originalLabel = btn ? btn.innerHTML : null;
                if (btn) { btn.innerHTML = 'Memeriksa token...'; btn.disabled = true; }
                await sinkronDataDariCloud();
                if (btn) { btn.innerHTML = originalLabel; btn.disabled = false; }
                validGuru = users_db.find(u => u.token === token);
            }
            if (!validGuru) {
                alert('Token Ujian tidak ditemukan! Pastikan token dari Guru benar dan Anda memiliki koneksi internet untuk sinkronisasi awal.');
                return;
            }

            let savedSession = localStorage.getItem('cbt_ongoing_session');
            if (savedSession) {
                let sessionData = JSON.parse(savedSession);
                if (sessionData.nama === nama && sessionData.token === token) {
                    if (confirm("Ditemukan sesi ujian yang belum selesai. Lanjutkan?")) {
                        currentStudent = { nama, kelas, sekolah, token_guru: token };
                        studentAnswers = sessionData.answers || {};
                        doubtAnswers = sessionData.doubts || {};
                        cheatCount = sessionData.cheatCount || 0;
                        examTimeLeft = sessionData.timeLeft || (40 * 60);
                        
                        document.getElementById('exam-student-name').innerText = escapeHTML(nama);
                        startExamTimer();
                        setupAntiCheat();
                        renderNav();
                        loadSoal(currentSoalIndex);
                        navigate('page-exam');
                        return;
                    }
                }
            }

            currentStudent = { nama, kelas, sekolah, token_guru: token };
            currentSoalIndex = 0;
            studentAnswers = {};
            doubtAnswers = {};
            cheatCount = 0;
            examTimeLeft = 40 * 60;
            
            document.getElementById('exam-student-name').innerText = escapeHTML(nama);
            
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(e => console.log(e));
            }
            
            startExamTimer();
            setupAntiCheat();
            renderNav();
            loadSoal(currentSoalIndex);
            navigate('page-exam');
            saveSession();
        }

        function saveSession() {
            if (!isExamActive) return;
            let sessionData = {
                nama: currentStudent.nama,
                token: currentStudent.token_guru,
                answers: studentAnswers,
                doubts: doubtAnswers,
                cheatCount: cheatCount,
                timeLeft: examTimeLeft
            };
